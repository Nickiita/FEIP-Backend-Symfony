<?xml version="1.0" encoding="UTF-8"?>
<psalm
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://getpsalm.org/schema/config.xsd"
        errorLevel="4"
        resolveFromConfigFile="true"
        cacheDirectory="var/cache/.psalm-cache"
>
    <projectFiles>
        <directory name="src" />
        <directory name="tests" />

        <excludeFile name="config/preload.php" />
        <excludeFile name="public/index.php" />

        <excludeDirectory name="bin" />
        <excludeDirectory name="var" />
        <excludeDirectory name="vendor" />
    </projectFiles>

    <issueHandlers>
        <InternalMethod>
            <ignoreInternalFunctionFalseReturn value="false" />
            <ignoreInternalFunctionNullReturn value="false" />
        </InternalMethod>

        <ArrayOffset>
            <ensureArrayIntOffsetsExist value="true" />
            <ensureArrayStringOffsetsExist value="true" />
        </ArrayOffset>

        <InvalidOperand>
            <strictBinaryOperands value="true" />
        </InvalidOperand>
    </issueHandlers>
</psalm>